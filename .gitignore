.venv/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.DS_Store
# Sobras do sistema de arquivos quando um arquivo e renomeado/apagado estando aberto (FUSE).
.fuse_hidden*
/dados/
/saidas/
/capturas/
/logs/
*.db
*.db-wal
*.db-shm
temas.yaml
temas.local.yaml
fontes.yaml
config/local.yaml
*.csv
!tests/fixtures/*.csv
# docs/: so os .md e a estrutura de pastas vao ao GitHub (repositorio privado); qualquer outro tipo de arquivo continua ignorado.
docs/*
!docs/.gitkeep
!docs/*.md
!docs/*/
docs/*/*
!docs/*/*.md
!docs/*/*/
docs/*/*/*
!docs/*/*/*.md
/.claude/settings.local.json
/.claude/estado/
/Claude outputs/
/_quarentena*/
