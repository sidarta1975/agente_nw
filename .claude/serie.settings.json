{
  "_leia": "Permissões da execução em série (brief 086, item 2.5). Passado por --settings pelo scripts/executar_serie.sh; a sessão interativa continua com o .claude/settings.json, que não muda. Traz os comandos que os briefs precisam e o allow do projeto não cobre (mkdir, cp, mv, sed, python3 em scripts/), repete o allow e o deny do projeto e repete os dois hooks, para a trava valer mesmo que este arquivo substitua o do projeto em vez de somar.",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(python3 scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(scripts/verificar.sh:*)",
      "Bash(scripts/agente_entregar.sh:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)",
      "Bash(scripts/commitar.sh:*)",
      "Bash(sqlite3 dados/agente.db:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_comando.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_arquivo.py\""
          }
        ]
      }
    ]
  }
}
