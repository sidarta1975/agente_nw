{
  "manifest_version": 3,
  "name": "agente_nw — leitura de redes sociais",
  "version": "1.0.0",
  "description": "Lê listas, buscas e perfis de rede social no seu Chrome, só quando o agente_nw pede.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8766/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8766/*"
      ],
      "js": [
        "ponte_conteudo.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icone.png"
  }
}
